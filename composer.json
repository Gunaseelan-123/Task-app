{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "northstar/commerce",
    "type": "project",
    "description": "Production-ready ecommerce platform built with Laravel 12.",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "serve-sqlite": "php -d extension=pdo_sqlite -d extension=sqlite3 artisan serve",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently \"php -d extension=pdo_sqlite -d extension=sqlite3 artisan serve\" \"npm run dev\" --names=server,vite"
        ],
        "test": [
            "@php artisan test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
